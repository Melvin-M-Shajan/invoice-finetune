# Copy to .env and fill in real values. Never commit .env.

# Gated HF model access (only needed if using meta-llama/Meta-Llama-3-8B-Instruct).
# Not needed for this repo's actual run — see README deviation notes (Mistral/small-model fallback used).
HF_TOKEN=

# Synthetic data generation (§5.3). PRD specifies OpenAI or Anthropic; this repo actually
# uses Gemini (the only key available at build time) — see README deviation notes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional training-run logging to Weights & Biases. If unset, training just skips W&B.
WANDB_API_KEY=

# Only needed if training on AWS SageMaker (§6.5). Not used in this repo's actual run —
# see README deviation notes (local-only training due to no AWS budget).
AWS_PROFILE=
AWS_REGION=
